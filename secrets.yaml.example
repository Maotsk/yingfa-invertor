# Скопируй этот файл в secrets.yaml и заполни своими значениями.

# --- WiFi ---
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# --- ESPHome API encryption key ---
# Сгенерировать можно так:
#   openssl rand -base64 32
yingfa_api_key: "REPLACE_ME_WITH_YOUR_OWN_KEY="

# --- Fallback AP password ---
# Пароль для точки доступа "PVinvertor Fallback Hotspot".
# Минимум 8 символов.
yingfa_ap_password: "REPLACE_ME"
